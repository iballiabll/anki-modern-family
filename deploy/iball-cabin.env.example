# 复制到 /etc/iball-cabin.env，改完再 systemctl restart iball-cabin
# 权限建议：chown root:iball && chmod 640

# 应用监听地址，Nginx 反代到这里
HOST=127.0.0.1
PORT=4175
NODE_ENV=production

# 必填：登录 Cookie 的签名密钥。生成方式：openssl rand -base64 48
# 换了密钥等于所有人被强制退出登录，别丢。
SESSION_SECRET=replace-me-with-openssl-rand-base64-48

# 账号文件目录。必须和仓库分开，更新代码时才不会覆盖账号。
DATA_DIR=/var/lib/iball-cabin/data

# 站长账号（旧版单账号登录），默认 iball
APP_USERNAME=iball

# 站长口令的 SHA-256。留空则沿用仓库内置口令。
# 生成方式：printf '%s' '你的新密码' | sha256sum | cut -d' ' -f1
# APP_PASSWORD_SHA256=

# 是否开放注册。true=任何人可注册，false=只有站长能进。
REGISTRATION_ENABLED=true

# 可选邀请码。填了就变成“有邀请码才能注册”，适合只给同学用。
# REGISTRATION_CODE=

# 账号数量上限，默认 20
MAX_USERS=20
